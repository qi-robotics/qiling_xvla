# Docker Hub 官方 ROS 镜像的国内代理。默认仅支持 x86_64。
QI_ROS_BUILD_IMAGE=m.daocloud.io/docker.io/library/ros:humble-ros-base-jammy
QI_ROS_RUNTIME_IMAGE=m.daocloud.io/docker.io/library/ros:humble-ros-core-jammy

# Ubuntu 22.04 与 ROS 2 Humble APT 镜像。
QI_UBUNTU_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ubuntu
QI_ROS2_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ros2/ubuntu

# 固定 Miniconda 版本并校验官方 SHA256，禁止使用易变化的 latest。
QI_MINICONDA_URL=https://mirrors.tuna.tsinghua.edu.cn/anaconda/miniconda/Miniconda3-py312_25.9.1-3-Linux-x86_64.sh
QI_MINICONDA_SHA256=07fc00c146a481f7ae2657a31eb7ec0d5d77a107b981d58ab5d7cd8bc99be778

# 普通 Python 包、PyTorch 及其 CUDA Python 依赖都优先从清华 PyPI 获取。
QI_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
