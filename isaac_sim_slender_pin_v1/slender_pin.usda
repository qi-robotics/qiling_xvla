#usda 1.0
(
    defaultPrim = "SlenderPin"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SlenderPin" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    bool physics:kinematicEnabled = 0
    double physics:mass = 0.002

    def Scope "Looks"
    {
        def Material "PinMaterial"
        {
            token outputs:surface.connect = </SlenderPin/Looks/PinMaterial/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.36, 0.82)
                float inputs:metallic = 0.02
                float inputs:roughness = 0.68
                token outputs:surface
            }
        }

        def Material "MarkerMaterial"
        {
            token outputs:surface.connect = </SlenderPin/Looks/MarkerMaterial/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.98, 0.98, 0.98)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
    }

    # One simple 26 x 30 x 44 mm rectangular pin. The socket's usable channel
    # is also 44 mm deep, so a fully seated pin is flush with the socket top.
    # There are no shoulders, hooks, lateral handles, or hidden grasp aids.
    def Cube "Body" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 0, 0.022)
        double3 xformOp:scale = (0.026, 0.030, 0.044)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </SlenderPin/Looks/PinMaterial>
        bool physics:collisionEnabled = 1
    }

    # A small visual-only line identifies local X+ without changing collision.
    def Cube "DirectionMarker" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0.008, 0, 0.0447)
        double3 xformOp:scale = (0.016, 0.004, 0.0014)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </SlenderPin/Looks/MarkerMaterial>
    }
}
